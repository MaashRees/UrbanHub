# ==========================================
# Option A : Data Lake Local (MinIO Docker)
# ==========================================
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_SECURE=false
# MINIO_BUCKET_BRONZE=bronze
# MINIO_BUCKET_SILVER=silver
# MINIO_BUCKET_GOLD=gold

# ==========================================
# Option B : Data Lake Cloud (Cloudflare R2)
# ==========================================
MINIO_ENDPOINT=a93b4466da0fed15631af91ef596e6a2.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=your_r2_access_key_id
MINIO_SECRET_KEY=your_r2_secret_access_key
MINIO_SECURE=true
MINIO_BUCKET_BRONZE=urbanhub-bronze
MINIO_BUCKET_SILVER=urbanhub-silver
MINIO_BUCKET_GOLD=urbanhub-gold

# ==========================================
# Clés API externes
# ==========================================
OPENAQ_API_KEY=your_openaq_api_key_here
